---
const activities = [
	{ role: "実行委員長", name: "JAWS DAYS 2026", year: "2026" },
	{ role: "オーガナイザー", name: "JAWS-UG Fukuoka", year: "現任" },
	{ role: "実行委員長", name: "PHPカンファレンス福岡 2023", year: "2023" },
	{ role: "実行委員長", name: "Backlog World 2024", year: "2024" },
	{ role: "主催", name: "ServerlessDays Fukuoka 2019", year: "2019" },
	{ role: "参加", name: "AWS re:Invent", year: "2023–2025" },
];
---

<section id="community" class="py-20 px-6 bg-navy-50 dark:bg-navy-900">
	<div class="mx-auto max-w-5xl">
		<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-10">Community</h2>
		<div class="space-y-4">
			{activities.map((activity) => (
				<div class="flex items-baseline gap-4">
					<span class="text-xs font-medium text-accent bg-accent/10 px-2 py-0.5 rounded shrink-0 w-24 text-center">
						{activity.role}
					</span>
					<span class="text-navy-800 dark:text-navy-200 font-medium">
						{activity.name}
					</span>
					<span class="text-xs text-navy-400 ml-auto shrink-0">{activity.year}</span>
				</div>
			))}
		</div>
	</div>
</section>
