---
const links = [
	{ label: "X (@seike460)", href: "https://x.com/seike460" },
	{ label: "GitHub", href: "https://github.com/seike460" },
	{ label: "SpeakerDeck", href: "https://speakerdeck.com/seike460" },
	{ label: "Blog", href: "https://blog.seike460.com" },
];
---

<section id="contact" class="py-20 px-6">
	<div class="mx-auto max-w-5xl">
		<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-6">Contact</h2>
		<p class="text-navy-600 dark:text-navy-400 mb-8">
			お仕事のご依頼・ご相談はフォームからお問い合わせください。
		</p>
		<a
			href="https://forms.gle/eH22tCcq6K8RYPBUA"
			target="_blank"
			rel="noopener noreferrer"
			class="inline-block px-6 py-3 bg-accent hover:bg-accent-dark text-white text-sm font-medium rounded-md transition-colors mb-12"
		>
			お問い合わせフォーム
		</a>
		<div class="border-t border-navy-200 dark:border-navy-800 pt-8">
			<div class="flex flex-wrap gap-6">
				{links.map((link) => (
					<a
						href={link.href}
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm text-navy-600 dark:text-navy-400 hover:text-accent transition-colors"
					>
						{link.label} ↗
					</a>
				))}
			</div>
		</div>
	</div>
</section>
