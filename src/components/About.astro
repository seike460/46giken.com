---
const focusAreas = [
	{
		title: "Serverless",
		desc: "Cloud Architecture",
		icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" /></svg>`,
	},
	{
		title: "Observability",
		desc: "OpenTelemetry",
		icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" /></svg>`,
	},
	{
		title: "Platform Engineering",
		desc: "Clean Architecture / CQRS+ES",
		icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.88 3.485a.75.75 0 01-1.12-.648V5.004a.75.75 0 01.372-.648l5.88-3.486a.75.75 0 01.75 0l5.88 3.486a.75.75 0 01.372.648v12.993a.75.75 0 01-1.12.648l-5.88-3.485a.75.75 0 00-.75 0z" /></svg>`,
	},
	{
		title: "AI / Bedrock",
		desc: "Amazon Q Developer",
		icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>`,
	},
];

const credentials = [
	"AWS Community Builder (Serverless)",
	"2025 Japan AWS Top Engineers (Services)",
	"JAWS-UG Fukuoka オーガナイザー",
];
---

<section id="about" class="py-20 px-6">
	<div class="mx-auto max-w-5xl">
		<p class="text-accent text-sm font-medium tracking-widest uppercase mb-3">Why YONROKU GIKEN</p>
		<h2 class="text-2xl md:text-3xl font-bold text-navy-900 dark:text-navy-100 mb-8">Everything Will Be Serverless を、実務で扱うために。</h2>

		<div class="space-y-4 text-navy-700 dark:text-navy-300 mb-10">
			<p class="text-sm text-navy-500 dark:text-navy-400">
				清家史郎 / ヨンロク技研 代表 / 株式会社Fusic プリンシパルエンジニア・エバンジェリスト
			</p>
			<p>
				サーバーレスを流行語としてではなく、設計上の選択肢として扱います。AWS Serverless の構成レビュー、Observability の導入、登壇や技術発信まで、複雑な技術を「進められる判断」に変えるのが役割です。
			</p>
		</div>

		<!-- Focus areas grid -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
			{focusAreas.map((area) => (
				<div class="flex flex-col items-center text-center p-4 rounded-xl border border-navy-200 dark:border-navy-800 bg-navy-50/50 dark:bg-navy-900/50">
					<div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent mb-3" set:html={area.icon}></div>
					<p class="text-sm font-semibold text-navy-900 dark:text-navy-100">{area.title}</p>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-1">{area.desc}</p>
				</div>
			))}
		</div>

		<!-- Credential badges -->
		<div class="flex flex-wrap gap-2 mb-6">
			{credentials.map((cred) => (
				<span class="inline-block px-3 py-1.5 bg-accent/10 text-accent text-xs font-medium rounded-full">
					{cred}
				</span>
			))}
		</div>

		<a href="/profile/" class="inline-flex items-center gap-1 text-sm text-accent hover:text-accent-dark transition-colors font-medium">
			対応領域と経歴の詳細を見る
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
		</a>
	</div>
</section>
