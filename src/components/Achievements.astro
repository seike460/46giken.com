---
const stats = [
	{ value: "91+", label: "登壇資料", sub: "SpeakerDeck" },
	{ value: "64+", label: "公開リポジトリ", sub: "GitHub" },
	{ value: "6", label: "AWS 認定資格", sub: "Certified" },
	{ value: "7+", label: "年のコミュニティ活動", sub: "since 2019" },
];
---

<section id="achievements" class="py-20 px-6 bg-navy-900 dark:bg-navy-950">
	<div class="mx-auto max-w-5xl">
		<h2 class="text-2xl font-bold text-white mb-10">Achievements</h2>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-8">
			{stats.map((stat) => (
				<div class="text-center">
					<p class="text-4xl md:text-5xl font-bold text-accent">{stat.value}</p>
					<p class="text-sm text-navy-300 mt-2">{stat.label}</p>
					<p class="text-xs text-navy-500 mt-1">{stat.sub}</p>
				</div>
			))}
		</div>
	</div>
</section>
