---
import { externalLinks, siteIdentity } from "../../data/identity";
---

<footer class="border-t border-line/80 bg-paper/80">
	<div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 md:flex-row md:items-end md:justify-between">
		<div class="max-w-xl space-y-3">
			<p class="font-display text-xl font-semibold tracking-tight text-ink">
				{siteIdentity.personName}
			</p>
			<p class="text-sm leading-7 text-muted">{siteIdentity.summary}</p>
			<p class="text-xs uppercase tracking-[0.18em] text-subtle">
				&copy; {new Date().getFullYear()} {siteIdentity.siteName}
			</p>
		</div>
		<div class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted">
			{externalLinks.map((link) => (
				<a
					href={link.href}
					target="_blank"
					rel="noopener noreferrer"
					class="transition hover:text-accent-strong"
				>
					{link.label}
				</a>
			))}
		</div>
	</div>
</footer>
