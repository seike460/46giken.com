---
import type { TimelineEntry } from "../../data/types";

interface Props {
	items: TimelineEntry[];
}

const { items } = Astro.props;
---

<div class="space-y-6">
	{items.map((item) => (
		<article class="grid gap-3 rounded-3xl border border-line bg-surface px-6 py-6 shadow-soft md:grid-cols-[8rem_1fr] md:gap-6">
			<p class="font-display text-2xl font-semibold tracking-tight text-accent-strong">{item.year}</p>
			<div>
				<h3 class="text-lg font-semibold text-ink">{item.title}</h3>
				<p class="mt-3 text-sm leading-7 text-muted">{item.body}</p>
			</div>
		</article>
	))}
</div>
