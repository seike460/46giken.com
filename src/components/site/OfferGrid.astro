---
import type { Offer } from "../../data/types";

interface Props {
	items: Offer[];
}

const { items } = Astro.props;
---

<div class="grid gap-5 lg:grid-cols-3">
	{items.map((item) => (
		<article class="rounded-3xl border border-line bg-surface px-6 py-6 shadow-soft">
			<p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-strong">Offer</p>
			<h3 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink">{item.title}</h3>
			<p class="mt-4 text-sm leading-7 text-muted">{item.summary}</p>
			<ul class="mt-6 space-y-3 text-sm leading-6 text-ink">
				{item.bullets.map((bullet) => (
					<li class="flex gap-3">
						<span class="mt-1 h-2 w-2 rounded-full bg-accent"></span>
						<span>{bullet}</span>
					</li>
				))}
			</ul>
		</article>
	))}
</div>
