---
interface Props {
	eyebrow?: string;
	title: string;
	intro: string;
	align?: "left" | "center";
}

const { eyebrow, title, intro, align = "left" } = Astro.props;
const centered = align === "center";
---

<div class:list={["space-y-4", centered && "text-center mx-auto max-w-3xl"]}>
	{eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-strong">{eyebrow}</p>}
	<h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">{title}</h2>
	<p class="max-w-3xl text-sm leading-7 text-muted md:text-base">
		{intro}
	</p>
</div>
