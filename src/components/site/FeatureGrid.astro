---
import type { FeaturedItem } from "../../data/types";

interface Props {
	items: FeaturedItem[];
}

const { items } = Astro.props;
---

<div class="grid gap-5 xl:grid-cols-2">
	{items.map((item) => (
		<article class="rounded-3xl border border-line bg-surface px-6 py-6 shadow-soft">
			<div class="flex items-center justify-between gap-4">
				<p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-strong">{item.kind}</p>
				<p class="text-xs uppercase tracking-[0.18em] text-subtle">{item.meta}</p>
			</div>
			<h3 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink">{item.title}</h3>
			<p class="mt-4 text-sm leading-7 text-muted">{item.summary}</p>
			<a
				href={item.href}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-ink transition hover:text-accent-strong"
			>
				<span>{item.ctaLabel}</span>
				<span aria-hidden="true">↗</span>
			</a>
		</article>
	))}
</div>
