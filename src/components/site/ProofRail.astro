---
import type { ProofMetric } from "../../data/types";

interface Props {
	items: ProofMetric[];
}

const { items } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-3">
	{items.map((item) => (
		<article class="rounded-3xl border border-line bg-surface px-6 py-5 shadow-soft">
			<p class="font-display text-4xl font-semibold tracking-tight text-ink">{item.value}</p>
			<p class="mt-2 text-sm font-semibold text-ink">{item.label}</p>
			<p class="mt-2 text-sm leading-6 text-muted">{item.note}</p>
			<div class="mt-4 flex items-center justify-between gap-4 text-[11px] uppercase tracking-[0.18em] text-subtle">
				<span>{item.verifiedAt}</span>
				<a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="transition hover:text-accent-strong">
					Source
				</a>
			</div>
		</article>
	))}
</div>
