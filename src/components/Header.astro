---
interface Props {
	currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

const navItems = [
	{ label: "支援内容", href: "/#services" },
	{ label: "相談例", href: "/#achievements" },
	{ label: "プロフィール", href: "/profile/" },
	{ label: "登壇・研修", href: "/speaking/" },
	{ label: "問い合わせ", href: "/#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-navy-950/80 backdrop-blur-md border-b border-navy-200 dark:border-navy-800">
	<div class="mx-auto max-w-5xl flex items-center justify-between px-6 h-14">
		<a href="/" class="text-lg font-bold tracking-tight text-navy-900 dark:text-navy-100">
			ヨンロク技研
		</a>
		<nav class="hidden md:flex items-center gap-6">
			{navItems.map((item) => {
				const isActive = !item.href.startsWith("/#") && currentPath === item.href;
				return (
					<a
						href={item.href}
						class={`text-sm transition-colors ${isActive ? "text-accent font-medium" : "text-navy-600 dark:text-navy-400 hover:text-accent"}`}
						aria-current={isActive ? "page" : undefined}
					>
						{item.label}
					</a>
				);
			})}
		</nav>
		<div class="flex items-center gap-2">
			<button
				id="theme-toggle"
				type="button"
				class="p-1.5 rounded-md text-navy-500 hover:text-navy-900 dark:hover:text-navy-100 transition-colors"
				aria-label="テーマ切替"
			>
				<svg class="dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
				</svg>
				<svg class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="5" />
					<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
				</svg>
			</button>
			<button
				id="menu-toggle"
				type="button"
				class="md:hidden p-1.5 rounded-md text-navy-500 hover:text-navy-900 dark:hover:text-navy-100 transition-colors"
				aria-label="メニュー"
				aria-expanded="false"
			>
				<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>
	<nav id="mobile-menu" class="hidden md:hidden border-t border-navy-200 dark:border-navy-800 bg-white/95 dark:bg-navy-950/95 backdrop-blur-md">
		<div class="px-6 py-4 space-y-3">
			{navItems.map((item) => {
				const isActive = !item.href.startsWith("/#") && currentPath === item.href;
				return (
					<a
						href={item.href}
						class={`block text-sm transition-colors ${isActive ? "text-accent font-medium" : "text-navy-600 dark:text-navy-400 hover:text-accent"}`}
						aria-current={isActive ? "page" : undefined}
					>
						{item.label}
					</a>
				);
			})}
		</div>
	</nav>
</header>

<script is:inline>
	document.getElementById("theme-toggle")?.addEventListener("click", () => {
		const html = document.documentElement;
		html.classList.toggle("dark");
		try { localStorage.setItem("theme", html.classList.contains("dark") ? "dark" : "light"); } catch (_) {}
	});
	document.getElementById("menu-toggle")?.addEventListener("click", () => {
		const menu = document.getElementById("mobile-menu");
		const btn = document.getElementById("menu-toggle");
		if (menu && btn) {
			const open = !menu.classList.contains("hidden");
			menu.classList.toggle("hidden");
			btn.setAttribute("aria-expanded", String(!open));
		}
	});
	document.getElementById("mobile-menu")?.addEventListener("click", (e) => {
		if (e.target instanceof HTMLAnchorElement) {
			document.getElementById("mobile-menu")?.classList.add("hidden");
			document.getElementById("menu-toggle")?.setAttribute("aria-expanded", "false");
		}
	});
</script>
