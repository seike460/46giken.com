---
const items = [
	{
		question: "設計が固まり切っていなくても相談できますか？",
		answer:
			"できます。むしろ、方向性が複数あって止まりやすい段階の相談に向いています。比較したい案、気になっている制約、期限感が分かると整理しやすくなります。",
	},
	{
		question: "構成図や資料がなくても大丈夫ですか？",
		answer:
			"大丈夫です。文章だけでも始められます。現状のシステム、困っている点、判断したいポイントを数行で送っていただければ十分です。",
	},
	{
		question: "登壇テーマがまだ決まっていなくても依頼できますか？",
		answer:
			"できます。対象者、イベントの狙い、避けたい内容が分かれば、テーマと難易度をこちらで整理して提案できます。",
	},
	{
		question: "実装を丸ごと受ける開発受託ですか？",
		answer:
			"主軸は受託開発ではなく、構成レビュー、設計判断、登壇・研修、技術広報支援です。実装そのものより、進め方と設計の質を上げる支援に強みがあります。",
	},
];
---

<section class="py-24 px-6 bg-navy-50 dark:bg-navy-900">
	<div class="mx-auto max-w-5xl">
		<p class="text-accent text-sm font-medium tracking-widest uppercase mb-3">FAQ</p>
		<h2 class="text-2xl md:text-3xl font-bold text-navy-900 dark:text-navy-100 mb-4">相談前によくある質問</h2>
		<p class="max-w-3xl text-sm md:text-base text-navy-600 dark:text-navy-400 mb-10">
			問い合わせ前に引っかかりやすい点を、先にここで解消しておきます。
		</p>

		<div class="space-y-4">
			{items.map((item) => (
				<details class="group rounded-2xl border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-800 p-6">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-semibold text-navy-900 dark:text-navy-100">
						<span>{item.question}</span>
						<span class="text-accent transition group-open:rotate-45">+</span>
					</summary>
					<p class="mt-4 text-sm leading-7 text-navy-600 dark:text-navy-400">
						{item.answer}
					</p>
				</details>
			))}
		</div>
	</div>
</section>
