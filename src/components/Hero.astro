---
import { heroCredentials } from "../data/identity";
---

<section data-hero class="relative min-h-[85vh] flex items-center px-6 bg-navy-900 dark:bg-navy-950 overflow-hidden">
	<!-- Background layers -->
	<div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950"></div>
	<div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(14,165,233,0.07) 1px, transparent 1px); background-size: 32px 32px;"></div>

	<!-- Glow orbs -->
	<div class="absolute -top-32 -left-32 w-[420px] h-[420px] rounded-full bg-accent/20 blur-[100px]" style="animation: float 8s ease-in-out infinite;"></div>
	<div class="absolute top-1/4 -right-20 w-[350px] h-[350px] rounded-full bg-warm-500/15 blur-[90px]" style="animation: float 10s ease-in-out infinite 2s;"></div>
	<div class="absolute -bottom-20 left-1/3 w-[300px] h-[300px] rounded-full bg-accent-light/10 blur-[80px]" style="animation: pulse-glow 6s ease-in-out infinite;"></div>

	<!-- Content -->
	<div class="relative mx-auto max-w-5xl w-full py-24">
		<p class="text-accent text-sm font-medium tracking-widest uppercase mb-6">
			AWS Serverless Design Review / Technical Advisory
		</p>
		<h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
			迷いのある設計を、<br class="hidden md:block" />進められる構成に変える。
		</h1>
		<p class="text-base md:text-lg text-navy-300 mb-1 leading-relaxed">
			AWS Serverless を前提に、構成レビューと技術アドバイザリーを提供しています。
		</p>
		<p class="text-base md:text-lg text-navy-300 mb-3 leading-relaxed">
			移行方針、サービス選定、Observability の設計まで、<span class="whitespace-nowrap">技術責任者</span>や<span class="whitespace-nowrap">開発チーム</span>が次の意思決定に進める状態まで整理します。
		</p>
		<p class="text-sm text-navy-500 italic mb-10">
			Everything Will Be Serverless
		</p>

		<!-- CTAs -->
		<div class="flex flex-wrap gap-4 mb-12">
			<a
				href="#contact"
				class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-accent to-accent-light text-white font-semibold rounded-full shadow-lg shadow-accent/25 hover:shadow-accent/40 hover:scale-105 transition-all duration-300"
			>
				構成レビューを相談する
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
			</a>
			<a
				href="/speaking/"
				class="inline-flex items-center gap-2 px-8 py-4 border border-navy-600 text-navy-300 hover:border-accent hover:text-white rounded-full transition-all duration-300"
			>
				登壇・研修の詳細を見る
			</a>
		</div>

		<!-- Proof rail -->
		<div class="flex flex-wrap gap-3">
			<span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/20 rounded-full text-xs text-emerald-400">
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
				</span>
				現在ご相談を受け付けています
			</span>
			{heroCredentials.slice(0, 4).map((cred) => (
				<span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-xs text-navy-300">
					<Fragment set:html={cred.icon} />
					{cred.badge ?? cred.title}
				</span>
			))}
		</div>
	</div>

	<!-- Wave divider -->
	<div class="absolute bottom-0 left-0 right-0">
		<svg viewBox="0 0 1440 60" fill="none" class="w-full block" preserveAspectRatio="none">
			<path d="M0 60L60 52C120 44 240 28 360 22C480 16 600 20 720 28C840 36 960 48 1080 50C1200 52 1320 44 1380 40L1440 36V60H0Z" class="fill-white dark:fill-navy-950" />
		</svg>
	</div>
</section>
