---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "ヨンロク技研 — Serverless Architecture & Cloud Engineering",
	description = "福岡を拠点に AWS Serverless を中心としたクラウドアーキテクチャの設計・実装・啓蒙活動を行う個人事業。代表 清家史郎 (@seike460)",
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://46giken.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="ヨンロク技研" />
		<meta property="og:image" content={`${siteUrl}og.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@seike460" />
		<meta name="twitter:image" content={`${siteUrl}og.png`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen">
		<script is:inline>
			try {
				const theme = localStorage.getItem("theme");
				if (theme === "dark" || (!theme && matchMedia("(prefers-color-scheme: dark)").matches)) {
					document.documentElement.classList.add("dark");
				}
			} catch (_) {}
		</script>
		<slot />
	</body>
</html>

<style is:global>
	@import "../styles/globals.css";
</style>
