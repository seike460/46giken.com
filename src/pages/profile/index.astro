---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { profileCredentials, siteIdentity } from "../../data/identity";
import { timeline } from "../../data/timeline";
import BaseLayout from "../../layouts/BaseLayout.astro";

const strengths = [
	{
		title: "サーバーレスアーキテクチャの構成レビュー",
		desc: "AWS Lambda、Step Functions、EventBridge を中心とした構成の妥当性確認と改善提案",
	},
	{
		title: "OpenTelemetry / Observability の導入設計",
		desc: "テレメトリー計装の設計から、Datadog・X-Ray との連携まで",
	},
	{
		title: "Clean Architecture / CQRS+ES への移行相談",
		desc: "既存システムの設計改善と、イベント駆動アーキテクチャへの段階的移行",
	},
	{
		title: "カンファレンスや社内勉強会での技術登壇",
		desc: "Serverless・Observability・設計をテーマに、対象者に合わせたセッションを提供",
	},
];

const credentials = profileCredentials;
---

<BaseLayout
	title="Profile | ヨンロク技研"
	description="AWS Serverless と Observability を軸に、構成レビュー、移行相談、登壇・研修を行う清家史郎のプロフィール。"
>
	<Header currentPath="/profile/" />
	<main id="content">
		<section class="pt-32 pb-20 px-6 bg-navy-900">
			<div class="mx-auto max-w-5xl">
				<p class="text-accent text-sm font-medium tracking-widest uppercase mb-4">Profile</p>
				<h1 class="text-4xl md:text-5xl font-bold text-white leading-tight mb-4">
					清家史郎
				</h1>
				<p class="text-navy-300 text-lg max-w-2xl">
					AWS Serverless と Observability を軸に、構成レビュー、移行相談、登壇・研修を行っています。技術組織の迷いを言語化し、次の設計判断に進める状態まで整理します。
				</p>
				<p class="text-navy-500 text-sm mt-3">
					ヨンロク技研 代表 / {siteIdentity.role}
				</p>
			</div>
		</section>

		<!-- 得意な相談テーマ（何を頼める人か） -->
		<section class="py-20 px-6">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-10">よく受ける相談</h2>
				<div class="grid md:grid-cols-2 gap-6">
					{strengths.map((s) => (
						<div class="border border-navy-200 dark:border-navy-700 rounded-xl p-6">
							<h3 class="text-base font-semibold text-navy-900 dark:text-navy-100 mb-2">{s.title}</h3>
							<p class="text-sm text-navy-600 dark:text-navy-400">{s.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 経歴ハイライト（頼む理由に絞る） -->
		<section class="py-20 px-6 bg-navy-50 dark:bg-navy-900">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-10">相談先としての裏付け</h2>
				<div class="grid md:grid-cols-2 gap-6">
					{credentials.map((item) => (
						<div class="bg-white dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-lg p-6">
							<p class="text-xs font-medium text-accent uppercase tracking-wide">
								{item.period ?? "Current"}
							</p>
							<h3 class="mt-3 text-lg font-semibold text-navy-900 dark:text-navy-100">{item.title}</h3>
							<p class="mt-2 text-sm text-navy-600 dark:text-navy-400">{item.detail}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 中間CTA -->
		<section class="py-16 px-6">
			<div class="mx-auto max-w-5xl">
				<div class="rounded-2xl bg-gradient-to-br from-navy-900 via-navy-800 to-navy-900 p-10 text-center">
						<h2 class="text-xl font-bold text-white mb-4">背景と悩みを送ってください</h2>
						<p class="text-navy-400 mb-6 max-w-md mx-auto text-sm">
							数行で構いません。状況を確認したうえで、対応可否と進め方のたたき台をご返信します。
						</p>
					<a
						href={siteIdentity.contactUrl}
						class="inline-flex items-center gap-2 px-8 py-4 bg-white text-accent-dark font-semibold rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300"
					>
							背景と悩みを送る
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
						</a>
					</div>
			</div>
		</section>

		<!-- 活動の年表（補助） -->
		<section class="py-20 px-6 bg-navy-50 dark:bg-navy-900">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-10">活動の年表</h2>
				<div class="space-y-6">
					{timeline.map((entry) => (
						<div class="flex items-baseline gap-4">
							<span class="text-xs font-medium text-accent bg-accent/10 px-2 py-0.5 rounded shrink-0 w-20 text-center">
								{entry.year}
							</span>
							<div>
								<p class="font-medium text-navy-800 dark:text-navy-200">{entry.title}</p>
								<p class="text-sm text-navy-500 dark:text-navy-400 mt-1">{entry.body}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
