---
import CallToAction from "../../components/site/CallToAction.astro";
import SectionIntro from "../../components/site/SectionIntro.astro";
import SiteFooter from "../../components/site/SiteFooter.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import Timeline from "../../components/site/Timeline.astro";
import { externalLinks, profileCredentials, siteIdentity } from "../../data/identity";
import { projects } from "../../data/projects";
import { timeline } from "../../data/timeline";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

	<BaseLayout
		title={`Profile | ${siteIdentity.personName} | ${siteIdentity.siteName}`}
		description="清家史郎の経歴、役割、表彰、運営実績、公開アーカイブを公開情報ベースで整理したプロフィールページ。"
	>
	<SiteHeader currentPath="/profile/" />
	<main id="content">
		<section class="border-b border-line/80">
			<div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
				<div class="max-w-4xl space-y-6">
					<p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-strong">Profile</p>
					<h1 class="font-display text-5xl font-semibold tracking-tight text-ink md:text-7xl">
						公開実績を起点に、<span class="block text-accent-strong">何をやってきた人かを整理する。</span>
					</h1>
					<p class="max-w-3xl text-base leading-8 text-muted md:text-lg">{siteIdentity.intro}</p>
				</div>
				<div class="mt-12 grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
					<article class="rounded-[2rem] border border-line bg-panel px-7 py-8 shadow-soft">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-subtle">Current</p>
						<h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-ink">
							{siteIdentity.personName}
						</h2>
						<p class="mt-3 text-sm leading-7 text-muted">{siteIdentity.role}</p>
						<p class="mt-6 text-sm leading-7 text-ink">{siteIdentity.summary}</p>
						<ul class="mt-8 flex flex-wrap gap-3">
							{siteIdentity.focusAreas.map((area) => (
								<li class="rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink">
									{area}
								</li>
							))}
						</ul>
					</article>
					<article class="rounded-[2rem] border border-line bg-surface px-7 py-8 shadow-soft">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-subtle">External Links</p>
						<ul class="mt-5 space-y-4">
							{externalLinks.map((link) => (
								<li>
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="block rounded-2xl border border-line px-4 py-4 transition hover:border-accent hover:bg-paper"
									>
										<p class="text-sm font-semibold text-ink">{link.label}</p>
										<p class="mt-1 text-sm leading-6 text-muted">{link.description}</p>
									</a>
								</li>
							))}
						</ul>
					</article>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
			<SectionIntro
				eyebrow="Credentials"
				title="現在の信頼材料"
				intro="所属、表彰、コミュニティ上の役割を、個人ブランドの背景として明示しています。"
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
				{profileCredentials.map((item) => (
					<article class="rounded-3xl border border-line bg-surface px-6 py-6 shadow-soft">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">
							{item.period ?? "Current"}
						</p>
						<h3 class="mt-4 text-lg font-semibold text-ink">{item.title}</h3>
						<p class="mt-3 text-sm leading-7 text-muted">{item.detail}</p>
						{item.sourceUrl && (
							<a
								href={item.sourceUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-ink transition hover:text-accent-strong"
							>
								<span>関連ソース</span>
								<span aria-hidden="true">↗</span>
							</a>
						)}
					</article>
				))}
			</div>
		</section>

		<section class="border-y border-line/80 bg-surface/80">
			<div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
					<SectionIntro
						eyebrow="Public Work"
						title="公開アーカイブ"
						intro="非公開リポジトリやクローズドな資料は載せず、誰でも辿れる公開アーカイブと公開プロフィールだけを掲載しています。"
					/>
				<div class="mt-10 grid gap-5 xl:grid-cols-3">
					{projects.map((project) => (
						<article class="rounded-3xl border border-line bg-panel px-6 py-6 shadow-soft">
							<p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">
								{project.proofType}
							</p>
							<h3 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink">
								{project.name}
							</h3>
							<p class="mt-4 text-sm leading-7 text-muted">{project.oneLiner}</p>
							<p class="mt-4 text-sm font-medium text-ink">{project.role}</p>
							<ul class="mt-5 flex flex-wrap gap-2">
								{project.stack.map((item) => (
									<li class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-ink">
										{item}
									</li>
								))}
							</ul>
							<a
								href={project.href}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-ink transition hover:text-accent-strong"
							>
								<span>公開先を見る</span>
								<span aria-hidden="true">↗</span>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
			<SectionIntro
				eyebrow="Timeline"
				title="コミュニティと発信の年表"
				intro="発信力は単年では作れません。どこで踏み出し、どこで役割を引き受けてきたかを簡潔に並べています。"
			/>
			<div class="mt-10">
				<Timeline items={timeline} />
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
			<div class="rounded-[2rem] border border-line bg-surface px-8 py-8 shadow-soft">
				<p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-strong">Verification Note</p>
					<p class="mt-4 max-w-4xl text-sm leading-7 text-muted">
						このページの数値と肩書きは、2026-03-29 時点で参照できた公開プロフィール、Speaker Deck、GitHub の公開プロフィール、Blog アーカイブなど、外部から辿れる公開情報をもとに整理しています。非公開リポジトリやクローズドな資料は、実績カードや導線としては掲載しません。
					</p>
				</div>
			</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
			<CallToAction
				title="技術相談の前に、人となりと実績を見たい場合はここを入口にしてください"
				copy="継続発信、設計、コミュニティ運営のどれに重心がある人なのかを先に把握してもらうためのプロフィールです。相談内容が固まっていれば、そのままフォームへ進んでもらって構いません。"
				primaryHref={siteIdentity.contactUrl}
				primaryLabel="フォームへ進む"
				secondaryHref="/speaking/"
				secondaryLabel="登壇ページを見る"
			/>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>
