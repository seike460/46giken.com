---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteIdentity } from "../../data/identity";
import { isUpcomingTalk, talks, talkThemes } from "../../data/talks";

const featuredTalks = talks.filter((talk) => talk.featured);

const speakingTopics = [
	{ theme: "Serverless", desc: "AWS Lambda、Step Functions、EventBridge を中心としたサーバーレス設計と運用" },
	{ theme: "Observability", desc: "OpenTelemetry、Datadog、X-Ray によるテレメトリー計装と可視化" },
	{ theme: "Clean Architecture", desc: "CQRS+ES、Event-Driven Design による保守性の高い設計" },
	{ theme: "AI × 開発", desc: "Amazon Bedrock、AI コーディングとの協働、構造駆動の開発手法" },
];

const formats = [
	{ label: "キーノート", detail: "30〜60分" },
	{ label: "テクニカルセッション", detail: "20〜45分" },
	{ label: "ワークショップ / ハンズオン", detail: "90〜180分" },
	{ label: "社内研修", detail: "半日〜1日" },
	{ label: "LT / パネル", detail: "5〜15分" },
];

const requestChecklist = [
	"イベント名、開催日時、会場またはオンライン",
	"対象者のレベル感と人数",
	"イベントや研修で持ち帰ってほしいこと",
	"話してほしいテーマ、または避けたい内容",
];
---

<BaseLayout
	title="登壇・研修のご依頼 | ヨンロク技研"
	description="Serverless・Observability・設計をテーマに、技術イベントと社内研修で登壇します。対象者、持ち帰り、対応形式を確認できます。"
>
	<Header currentPath="/speaking/" />
	<main id="content">
		<!-- Hero: 依頼ページとしての入口 -->
		<section class="pt-32 pb-20 px-6 bg-navy-900">
			<div class="mx-auto max-w-5xl">
				<p class="text-accent text-sm font-medium tracking-widest uppercase mb-4">Speaking & Training</p>
				<h1 class="text-4xl md:text-5xl font-bold text-white leading-tight mb-4">
					技術イベントと社内研修に、理解で終わらない登壇を。
				</h1>
				<p class="text-navy-300 text-lg mb-8 max-w-2xl">
					Serverless・Observability・設計をテーマに、対象者のレベルと目的に合わせて構成します。聞いて終わりではなく、次の行動につながるセッションに調整します。
				</p>
				<div class="flex flex-wrap gap-4">
					<a
						href={siteIdentity.contactUrl}
						class="inline-block px-6 py-3 bg-accent hover:bg-accent-dark text-white text-sm font-medium rounded-full transition-colors"
					>
						登壇・研修を相談する
					</a>
					<a
						href="#featured-sessions"
						class="inline-block px-6 py-3 border border-navy-600 text-navy-300 hover:text-white hover:border-accent text-sm font-medium rounded-full transition-colors"
					>
						代表セッションを見る
					</a>
				</div>
			</div>
		</section>

		<!-- 話せるテーマ & 対応形式 -->
		<section class="py-20 px-6">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-10">こんなテーマで話せます</h2>
				<div class="grid md:grid-cols-2 gap-6 mb-16">
					{speakingTopics.map((topic) => (
						<div class="border border-navy-200 dark:border-navy-700 rounded-xl p-6">
							<h3 class="text-lg font-semibold text-navy-900 dark:text-navy-100 mb-2">{topic.theme}</h3>
							<p class="text-sm text-navy-600 dark:text-navy-400">{topic.desc}</p>
						</div>
					))}
				</div>

				<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-6">対応形式</h2>
				<div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 mb-8">
					{formats.map((f) => (
						<div class="flex items-center gap-3 p-4 rounded-lg bg-navy-50 dark:bg-navy-800">
							<span class="text-accent font-medium text-sm">{f.label}</span>
							<span class="text-xs text-navy-500">{f.detail}</span>
						</div>
					))}
				</div>
				<p class="text-sm text-navy-500 dark:text-navy-400">
					日本語対応 / オンライン・オフライン両対応 / 初級〜上級のエンジニア、マネージャー層にも調整可能
				</p>
			</div>
		</section>

		<section class="py-20 px-6 bg-navy-50 dark:bg-navy-900">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-4">相談時にあると助かる情報</h2>
				<p class="max-w-3xl text-sm md:text-base text-navy-600 dark:text-navy-400 mb-8">
					テーマが固まっていなくても大丈夫です。以下が分かる範囲であると、提案の精度が上がります。
				</p>
				<div class="grid md:grid-cols-2 gap-4">
					{requestChecklist.map((item) => (
						<div class="rounded-xl border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-800 p-5 text-sm text-navy-700 dark:text-navy-300">
							<span class="mr-2 text-accent">•</span>
							{item}
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 代表セッション（証拠） -->
		<section id="featured-sessions" class="py-20 px-6 bg-navy-900 dark:bg-navy-950">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-bold text-white mb-10">代表セッション</h2>
				<div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
					{featuredTalks.map((talk) => (
						<div class="bg-navy-800 border border-navy-700 rounded-lg p-6">
							<p class="text-xs font-medium text-accent uppercase tracking-wide">{talk.theme}</p>
							<h3 class="mt-3 text-lg font-semibold text-white">{talk.title}</h3>
							<p class="mt-2 text-sm text-navy-300">{talk.event}</p>
							<p class="mt-1 text-xs text-navy-500">{talk.date}</p>
							<p class="mt-3 text-sm text-navy-400">{talk.summary}</p>
							<div class="mt-4 flex flex-wrap gap-4">
								<a href={talk.href} target="_blank" rel="noopener noreferrer" class="text-sm text-accent hover:text-accent-light transition-colors">Slides ↗</a>
								{talk.proofUrl && (
									<a href={talk.proofUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-navy-400 hover:text-accent transition-colors">Event ↗</a>
								)}
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 登壇依頼CTA（再度） -->
		<section class="py-20 px-6">
			<div class="mx-auto max-w-5xl">
					<div class="rounded-2xl bg-gradient-to-br from-navy-900 via-navy-800 to-navy-900 p-10 md:p-14 text-center">
						<h2 class="text-2xl font-bold text-white mb-4">イベントの目的に合わせて組み立てます</h2>
						<p class="text-navy-400 mb-8 max-w-lg mx-auto">
							イベント名、対象者、狙いをお知らせください。合うテーマと進め方を整理してご返信します。
						</p>
					<a
						href={siteIdentity.contactUrl}
						class="inline-flex items-center gap-2 px-8 py-4 bg-white text-accent-dark font-semibold rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300"
					>
							登壇・研修を相談する
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
						</a>
					</div>
			</div>
		</section>

		<!-- テーマ別アーカイブ（補助） -->
		<section class="py-20 px-6 bg-navy-50 dark:bg-navy-900">
			<div class="mx-auto max-w-5xl">
				<h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-10">テーマ別一覧</h2>
				<div class="grid lg:grid-cols-2 gap-8">
					{talkThemes.map((theme) => (
						<div>
							<div class="flex items-center justify-between mb-6">
								<h3 class="text-xl font-bold text-navy-900 dark:text-navy-100">{theme}</h3>
								<span class="text-xs text-navy-500">
									{talks.filter((t) => t.theme === theme).length} sessions
								</span>
							</div>
							<div class="space-y-6">
								{talks.filter((t) => t.theme === theme).map((talk) => (
									<div class="border-t border-navy-200 dark:border-navy-700 pt-5 first:border-none first:pt-0">
										<p class="text-xs text-navy-400 flex items-center gap-2">
											<span>{talk.date}</span>
											{isUpcomingTalk(talk) && (
												<span class="px-1.5 py-0.5 text-[10px] font-semibold text-accent border border-accent/40 rounded-full">予定</span>
											)}
										</p>
										<h4 class="mt-1 text-base font-semibold text-navy-900 dark:text-navy-100">{talk.title}</h4>
										<p class="mt-1 text-sm text-navy-600 dark:text-navy-400">{talk.event}</p>
										<div class="mt-3 flex flex-wrap gap-4">
											<a href={talk.href} target="_blank" rel="noopener noreferrer" class="text-sm text-accent hover:text-accent-dark transition-colors">Slides ↗</a>
											{talk.proofUrl && (
												<a href={talk.proofUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-navy-400 hover:text-accent transition-colors">Event ↗</a>
											)}
										</div>
									</div>
								))}
							</div>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
