---
import CallToAction from "../../components/site/CallToAction.astro";
import ProofRail from "../../components/site/ProofRail.astro";
import SectionIntro from "../../components/site/SectionIntro.astro";
import SiteFooter from "../../components/site/SiteFooter.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import { externalLinks, siteIdentity } from "../../data/identity";
import { proofMetrics } from "../../data/metrics";
import { talks, talkThemes } from "../../data/talks";
import BaseLayout from "../../layouts/BaseLayout.astro";

const featuredTalks = talks.filter((talk) => talk.featured);
---

<BaseLayout
	title={`Speaking | ${siteIdentity.personName} | ${siteIdentity.siteName}`}
	description="清家史郎の登壇テーマと代表セッションの一覧。Serverless、Observability、Architecture、AI / API を軸に整理しています。"
>
	<SiteHeader currentPath="/speaking/" />
	<main id="content">
		<section class="border-b border-line/80">
			<div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
				<div class="grid gap-10 lg:grid-cols-[1fr_0.9fr]">
					<div class="space-y-6">
						<p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent-strong">Speaking</p>
						<h1 class="font-display text-5xl font-semibold tracking-tight text-ink md:text-7xl">
							技術テーマの広さより、<span class="block text-accent-strong">実務へ持ち帰れる密度を優先する。</span>
						</h1>
						<p class="max-w-3xl text-base leading-8 text-muted md:text-lg">
							Serverless を起点にしつつ、OpenTelemetry による可観測性、Clean Architecture、AI / API 開発まで領域を広げています。登壇の強みは、概念の説明だけで終わらせず、実装と運用の落としどころまで持っていくことです。
						</p>
						<div class="flex flex-wrap gap-3">
							<a
								href="https://speakerdeck.com/seike460"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent-strong"
							>
								Speaker Deck を開く
							</a>
							<a
								href={siteIdentity.contactUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center rounded-full border border-line bg-surface px-6 py-3 text-sm font-semibold text-ink transition hover:border-accent hover:text-accent-strong"
							>
								登壇相談を送る
							</a>
						</div>
					</div>
					<article class="rounded-[2rem] border border-line bg-panel px-7 py-8 shadow-soft">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-subtle">Focus Themes</p>
						<ul class="mt-6 space-y-4">
							{talkThemes.map((theme) => (
								<li class="rounded-2xl border border-line bg-surface px-4 py-4">
									<p class="text-sm font-semibold text-ink">{theme}</p>
									<p class="mt-2 text-sm leading-6 text-muted">
										{theme === "Serverless" && "導入・運用・チーム適用の現実解を扱う。"}
										{theme === "Observability" && "OpenTelemetry を軸に監視の次をどう作るかを扱う。"}
										{theme === "Architecture" && "Clean Architecture や設計継承の実務を扱う。"}
										{theme === "AI / API" && "AI 活用と API 設計を構造化して扱う。"}
									</p>
								</li>
							))}
						</ul>
					</article>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
			<SectionIntro
				eyebrow="Proof"
				title="発信量そのものも、継続の証拠として使う"
				intro="イベント名や肩書きだけではなく、外から追える公開アーカイブを重視しています。"
			/>
			<div class="mt-10">
				<ProofRail items={proofMetrics} />
			</div>
		</section>

		<section class="border-y border-line/80 bg-surface/80">
			<div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
				<SectionIntro
					eyebrow="Featured Talks"
					title="現在の代表セッション"
					intro="いまの専門性を最も短く伝えられる登壇を先頭に置いています。"
				/>
				<div class="mt-10 grid gap-5 xl:grid-cols-3">
					{featuredTalks.map((talk) => (
						<article class="rounded-3xl border border-line bg-panel px-6 py-6 shadow-soft">
							<p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">
								{talk.theme}
							</p>
							<h2 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink">
								{talk.title}
							</h2>
							<p class="mt-3 text-sm font-medium text-ink">{talk.event}</p>
							<p class="mt-1 text-xs uppercase tracking-[0.18em] text-subtle">{talk.date}</p>
							<p class="mt-4 text-sm leading-7 text-muted">{talk.summary}</p>
							<div class="mt-6 flex flex-wrap gap-3">
								<a
									href={talk.href}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 text-sm font-semibold text-ink transition hover:text-accent-strong"
								>
									<span>Slides</span>
									<span aria-hidden="true">↗</span>
								</a>
								{talk.proofUrl && (
									<a
										href={talk.proofUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition hover:text-accent-strong"
									>
										<span>Event</span>
										<span aria-hidden="true">↗</span>
									</a>
								)}
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
			<SectionIntro
				eyebrow="Topics"
				title="テーマ別アーカイブ"
				intro="ジャンルを広げること自体が目的ではなく、実務の接続点を増やすためにテーマを拡張しています。"
			/>
			<div class="mt-10 grid gap-5 lg:grid-cols-2">
				{talkThemes.map((theme) => (
					<section id={theme.toLowerCase().replace(/[^a-z0-9]+/g, "-")} class="rounded-[2rem] border border-line bg-surface px-6 py-6 shadow-soft">
						<div class="flex items-center justify-between gap-4">
							<h2 class="font-display text-2xl font-semibold tracking-tight text-ink">{theme}</h2>
							<span class="text-xs uppercase tracking-[0.18em] text-subtle">
								{talks.filter((talk) => talk.theme === theme).length} items
							</span>
						</div>
						<div class="mt-6 space-y-5">
							{talks
								.filter((talk) => talk.theme === theme)
								.map((talk) => (
									<article class="border-t border-line pt-5 first:border-none first:pt-0">
										<p class="text-xs uppercase tracking-[0.18em] text-subtle">{talk.date}</p>
										<h3 class="mt-2 text-lg font-semibold text-ink">{talk.title}</h3>
										<p class="mt-1 text-sm font-medium text-muted">{talk.event}</p>
										<p class="mt-3 text-sm leading-7 text-muted">{talk.summary}</p>
										<div class="mt-4 flex flex-wrap gap-3">
											<a
												href={talk.href}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center gap-2 text-sm font-semibold text-ink transition hover:text-accent-strong"
											>
												<span>Slides</span>
												<span aria-hidden="true">↗</span>
											</a>
											{talk.proofUrl && (
												<a
													href={talk.proofUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition hover:text-accent-strong"
												>
													<span>Proof</span>
													<span aria-hidden="true">↗</span>
												</a>
											)}
										</div>
									</article>
								))}
						</div>
					</section>
				))}
			</div>
		</section>

		<section class="border-y border-line/80 bg-surface/80">
			<div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
				<SectionIntro
					eyebrow="Archive"
					title="外部アーカイブへの導線"
					intro="Speaker Deck を中核に、Blog と connpass を補助線にして発信履歴を辿れるようにしています。"
				/>
				<div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
					{externalLinks.map((link) => (
						<a
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-3xl border border-line bg-panel px-6 py-6 shadow-soft transition hover:border-accent hover:bg-surface"
						>
							<p class="text-lg font-semibold text-ink">{link.label}</p>
							<p class="mt-3 text-sm leading-7 text-muted">{link.description}</p>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
			<CallToAction
				title="イベント、勉強会、社内研修の相談に使ってください"
				copy="単発の講演だけでなく、テーマ設計、対象者に合わせた再編集、継続的な発信戦略まで含めて調整できます。"
				primaryHref={siteIdentity.contactUrl}
				primaryLabel="登壇相談を送る"
				secondaryHref="/profile/"
				secondaryLabel="プロフィールへ戻る"
			/>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>
